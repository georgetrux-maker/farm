# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Chỉ dùng khi phát triển trên máy cá nhân ---
# 1 = request không kèm token được coi là user demo (Linh Chi, quyền admin). Tắt (0) khi chạy thật.
ALLOW_DEMO_USER=1
# Token cố định cho user demo (tùy chọn), frontend gửi qua header Authorization: Bearer <token>
DEMO_USER_TOKEN=

# --- Tài khoản ---
# Khóa bí mật, ít nhất 32 ký tự ngẫu nhiên. Tạo bằng:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Dùng để mã hóa token TikTok/Facebook và các key nhập trong trang Quản trị → Cài đặt API.
# ĐỔI KHÓA = phải kết nối lại mạng xã hội và nhập lại các key đã lưu trong trang Quản trị.
APP_SECRET_KEY=
# Cho phép tự đăng ký tài khoản (1/0) và số credit tặng khi đăng ký
ALLOW_SIGNUP=1
SIGNUP_BONUS_CREDITS=0
SESSION_DAYS=30
# Địa chỉ giao diện web (nơi chuyển về sau khi kết nối TikTok/Facebook)
FRONTEND_URL=http://localhost:5173

# --- Bảo mật ---
# Mật khẩu cho thao tác vận hành (xác nhận tiền đã về). Đặt chuỗi dài, ngẫu nhiên.
ADMIN_TOKEN=
# Các domain frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120

# --- Thanh toán VietQR ---
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=AURA FASHION AI

# --- Tự động xác nhận tiền về qua SePay (https://my.sepay.vn) ---
# Tạo webhook trỏ tới  https://<domain>/api/webhooks/sepay , kiểu chứng thực "API Key",
# rồi dán cùng API key đó vào đây.
SEPAY_WEBHOOK_KEY=

# --- Đăng video lên mạng xã hội ---
# TikTok: tạo app tại https://developers.tiktok.com, bật Login Kit + Content Posting API (Direct Post),
#   khai báo Redirect URI:  https://<domain>/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_LABEL_AIGC=1
# Facebook: tạo app tại https://developers.facebook.com, thêm Facebook Login,
#   Valid OAuth Redirect URI:  https://<domain>/api/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

# --- Pipeline ---
# Giá mỗi video (1 credit = 100đ). Mặc định 30 credit chỉ hợp với engine tạm.
# Khi bật AI thật, chi phí mỗi video khoảng: Claude ~1-3 cent, FASHN ~0,075 USD/ảnh,
# Kling 5 giây khoảng 0,3-1,5 USD tùy chế độ => nên đặt từ 300-600 credit/video.
PIPELINE_COST_CREDITS=30
# Phần credit giữ lại khi người bán từ chối ảnh thử đồ (đã tốn phí thử đồ)
TRYON_PREVIEW_COST_CREDITS=5
# Số video tạo song song (số luồng, hoặc số tiến trình của worker Celery)
PIPELINE_MAX_WORKERS=2
# Hàng đợi tạo video:
#   thread (mặc định): chạy ngay trong tiến trình web, không cần cài thêm gì
#   celery: gửi việc qua Redis cho worker riêng; khởi động lại web không làm dở video.
#           docker-compose.yml đã bật sẵn chế độ này (service redis + worker)
QUEUE_BACKEND=thread
REDIS_URL=redis://localhost:6379/0
# Chế độ celery: khi khởi động, job "đang xử lý" đã tạo quá số phút này thì coi là lỗi và hoàn credit
STALE_JOB_MINUTES=120
MAX_UPLOAD_MB=10
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_SEC=180

# --- AI thật (để trống = dùng engine tạm miễn phí) ---
# Claude: phân tích ảnh sản phẩm, chấm chất lượng ảnh, viết kịch bản + caption + hashtag
#   Lấy key tại https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# FASHN: thử đồ lên người mẫu. Lấy key tại https://app.fashn.ai
FASHN_API_KEY=
FASHN_MODEL_NAME=tryon-v1.6
# performance | balanced | quality
FASHN_MODE=balanced
# Replicate: tạo video từ ảnh (mặc định Kling 3.0). Lấy token tại https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v3-video
# standard (720p) | pro (1080p, đắt hơn)
KLING_MODE=standard
# Thời gian chờ tối đa cho mỗi bước AI (giây)
AI_TIMEOUT_SEC=600
# Địa chỉ công khai của server (vd https://app.cuaban.vn). Có giá trị này thì AI tải ảnh trực tiếp
# từ server thay vì phải upload lại, nhanh hơn. Để trống khi chạy trên máy cá nhân.
PUBLIC_BASE_URL=

# --- Đường dẫn dữ liệu (mặc định nằm trong thư mục backend) ---
# AURA_DB_PATH=
# AURA_MEDIA_DIR=
